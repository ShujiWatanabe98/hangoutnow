{
  "name": "hangout-now",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:api": "npm run dev -w @hangout-now/api",
    "demo:seed": "node scripts/seed-public-demo.mjs",
    "demo:seed:direct": "node scripts/seed-mutual-five-star-demo.mjs",
    "demo:seed:week": "node scripts/seed-week-history-demo.mjs"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "5.9.3"
  },
  "engines": { "node": ">=20" }
}
