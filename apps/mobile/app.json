{
  "expo": {
    "name": "Hangout Now",
    "slug": "hangout-now",
    "version": "1.0.0",
    "description": "やりたいことから、近くの仲間とつながるアクティビティマッチングアプリ",
    "icon": "./assets/icon.png",
    "scheme": "hangoutnow",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hangoutnow.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.hangoutnow.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#163f31"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "userInterfaceStyle": "light"
    },
    "extra": {
      "apiUrl": "https://hangoutnow-api.onrender.com",
      "eas": {
        "projectId": "bea5cd54-c3f7-481e-abb9-c7ebf60be13f"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#f5f3eb"
        }
      ],
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "プロフィール写真を選択するため、写真ライブラリへのアクセスを使用します。",
          "cameraPermission": "プロフィール写真を撮影するため、カメラへのアクセスを使用します。"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "近くのHangoutを表示するため、現在地を使用します。"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "owner": "shujiwatanabe"
  }
}
