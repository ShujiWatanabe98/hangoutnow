generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VerificationStatus {
  UNVERIFIED
  PHONE_VERIFIED
}

enum AccountStatus {
  ACTIVE
  WARNED
  SUSPENDED
  BANNED
}

model User {
  id             String         @id @db.Uuid
  email          String         @unique
  passwordHash   String         @map("password_hash")
  displayName    String         @map("display_name")
  birthDate      DateTime?      @map("birth_date") @db.Date
  gender         Gender?
  bio            String?
  homeArea       String?        @map("home_area")
  preferredAreas String[]       @default([]) @map("preferred_areas")
  preferredActivities String[]  @default([]) @map("preferred_activities")
  preferredAgeMin Int?          @map("preferred_age_min")
  preferredAgeMax Int?          @map("preferred_age_max")
  preferredGenders Gender[]     @default([]) @map("preferred_genders")
  activityTimeSlots String[]    @default([]) @map("activity_time_slots")
  matchingDataConsent Boolean   @default(false) @map("matching_data_consent")
  matchingDataConsentAt DateTime? @map("matching_data_consent_at")
  participationUrgency ParticipationUrgency? @map("participation_urgency")
  maxTravelMinutes Int?           @map("max_travel_minutes")
  preferredGroupSizes Int[]       @default([]) @map("preferred_group_sizes")
  budgetMin        Int?           @map("budget_min")
  budgetMax        Int?           @map("budget_max")
  socialStyles     String[]       @default([]) @map("social_styles")
  participationGoals String[]     @default([]) @map("participation_goals")
  firstTimePreferences String[]   @default([]) @map("first_time_preferences")
  alcoholPreference String?       @map("alcohol_preference")
  smokingPreference String?       @map("smoking_preference")
  avoidPreferences  String[]      @default([]) @map("avoid_preferences")
  scheduleFlexibility String[]    @default([]) @map("schedule_flexibility")
  behaviorLearningEnabled Boolean @default(false) @map("behavior_learning_enabled")
  preferredLanguages String[]     @default([]) @map("preferred_languages")
  verification   VerificationStatus @default(UNVERIFIED)
  /// S3-compatible object URL in production. Never persist profile image bytes or base64 data URLs in production.
  profilePhoto   String?        @map("profile_photo") @db.Text
  profilePhotos  String[]       @default([]) @map("profile_photos")
  phoneNumber    String?        @unique @map("phone_number")
  notificationsEnabled Boolean @default(true) @map("notifications_enabled")
  accountStatus  AccountStatus @default(ACTIVE) @map("account_status")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  interests      UserInterest[]
  refreshTokens  RefreshToken[]
  hostedHangouts Hangout[]      @relation("HostHangouts")
  joinRequests   JoinRequest[]
  messages       Message[]
  directChatsStarted DirectChat[] @relation("DirectChatStarter")
  directChatsReceived DirectChat[] @relation("DirectChatRecipient")
  directMessages DirectMessage[]
  ratingsGiven   HangoutRating[] @relation("RatingsGiven")
  ratingsReceived HangoutRating[] @relation("RatingsReceived")
  stamps          UserStamp[]
  blocksCreated  Block[]        @relation("Blocker")
  blocksReceived Block[]        @relation("Blocked")
  reportsCreated Report[]       @relation("Reporter")
  reportsReceived Report[]      @relation("ReportedUser")
  moderationActions ModerationAction[] @relation("ModeratedUser")
  phoneVerifications PhoneVerification[]
  notifications Notification[]
  pushTokens PushToken[]
  hangoutHearts HangoutHeart[]
  oauthIdentities OAuthIdentity[]
  oauthLoginTickets OAuthLoginTicket[]
  matchFeedbacks MatchFeedback[]

  @@map("users")
}

model OAuthIdentity {
  id        String   @id @db.Uuid
  provider  String
  subject   String
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
  @@map("oauth_identities")
}

model OAuthLoginTicket {
  id           String    @id @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  provider     String
  subject      String
  displayName  String?   @map("display_name")
  profilePhoto String?   @map("profile_photo") @db.Text
  userId       String?   @map("user_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at")
  usedAt       DateTime? @map("used_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([provider, subject])
  @@index([expiresAt])
  @@map("oauth_login_tickets")
}

model PushToken {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  platform  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

model UserStamp {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  imageUrl  String   @map("image_url") @db.Text
  text      String
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("user_stamps")
}

model Notification {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String
  title     String
  body      String
  link      String?
  eventKey  String?  @unique @map("event_key")
  readAt    DateTime? @map("read_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model PhoneVerification {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  phone     String
  codeHash  String    @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  attempts  Int       @default(0)
  requestIp String?   @map("request_ip")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([phone, createdAt])
  @@index([requestIp, createdAt])
  @@map("phone_verifications")
}

enum HangoutStatus {
  OPEN
  FULL
  STARTED
  FINISHED
  CANCELLED
}
enum ServiceArea {
  SHINJUKU
  SHIBUYA
}

enum FunnelEventType {
  DISCOVERY_VIEWED
  HANGOUT_VIEWED
  JOIN_REQUESTED
  JOIN_ACCEPTED
  HANGOUT_CREATED
  HANGOUT_COMPLETED
}
enum ParticipationUrgency {
  NOW
  TODAY
  THIS_WEEK
  WEEKEND
  FLEXIBLE
}
enum MatchOutcome {
  MATCHED
  NOT_MATCHED
}
enum MatchDeclineReason {
  TIME
  DISTANCE
  FULL
  BUDGET
  CONDITIONS
  OTHER
}
enum Gender {
  MALE
  FEMALE
  OTHER
  UNDISCLOSED
}
enum GenderRestriction {
  ANY
  MALE_ONLY
  FEMALE_ONLY
}
enum JoinRequestStatus {
  PENDING
  ACCEPTED
  WAITLISTED
  REJECTED
  CANCELLED
}

enum AttendanceStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  CANCELLED
}

model Hangout {
  id              String         @id @db.Uuid
  hostUserId      String         @map("host_user_id") @db.Uuid
  title           String
  description     String?
  imageUrl         String?        @map("image_url") @db.Text
  category        String
  serviceArea     ServiceArea    @map("service_area")
  startAt         DateTime       @map("start_at")
  locationName    String         @map("location_name")
  meetingPlaceName String?       @map("meeting_place_name")
  meetingAddress  String?        @map("meeting_address")
  navigationUrl   String?        @map("navigation_url")
  publicLocationName String      @map("public_location_name")
  latitude        Float?
  longitude       Float?
  publicLatitude  Float?         @map("public_latitude")
  publicLongitude Float?         @map("public_longitude")
  maxParticipants Int            @map("max_participants")
  hostMaleCount   Int            @default(1) @map("host_male_count")
  hostFemaleCount Int            @default(0) @map("host_female_count")
  genderRestriction GenderRestriction @default(ANY) @map("gender_restriction")
  maxAge          Int?           @map("max_age")
  isDemo          Boolean        @default(false) @map("is_demo")
  status          HangoutStatus  @default(OPEN)
  startedAt       DateTime?      @map("started_at")
  endedAt         DateTime?      @map("ended_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  host            User           @relation("HostHangouts", fields: [hostUserId], references: [id], onDelete: Cascade)
  joinRequests    JoinRequest[]
  chatRoom        ChatRoom?
  reports         Report[]
  ratings         HangoutRating[]
  funnelEvents    FunnelEvent[]
  hearts          HangoutHeart[]
  matchFeedbacks  MatchFeedback[]

  @@index([status, startAt])
  @@index([status, startedAt])
  @@index([serviceArea, status, startAt])
  @@index([isDemo, status, startAt])
  @@index([hostUserId])
  @@map("hangouts")
}

model HangoutHeart {
  hangoutId String   @map("hangout_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  hangout   Hangout  @relation(fields: [hangoutId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([hangoutId, userId])
  @@index([userId, createdAt])
  @@map("hangout_hearts")
}

model FunnelEvent {
  id        String          @id @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  hangoutId String?         @map("hangout_id") @db.Uuid
  eventType FunnelEventType @map("event_type")
  createdAt DateTime        @default(now()) @map("created_at")
  hangout   Hangout?        @relation(fields: [hangoutId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
  @@index([hangoutId, eventType, createdAt])
  @@index([userId, createdAt])
  @@map("funnel_events")
}

model MatchFeedback {
  id        String             @id @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  hangoutId String             @map("hangout_id") @db.Uuid
  outcome   MatchOutcome
  reason    MatchDeclineReason?
  algorithmVersion String          @default("legacy-v0") @map("algorithm_version")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  hangout   Hangout            @relation(fields: [hangoutId], references: [id], onDelete: Cascade)

  @@unique([userId, hangoutId])
  @@index([outcome, reason, createdAt])
  @@map("match_feedback")
}

model HangoutRating {
  id          String   @id @db.Uuid
  hangoutId   String   @map("hangout_id") @db.Uuid
  raterUserId String   @map("rater_user_id") @db.Uuid
  ratedUserId String   @map("rated_user_id") @db.Uuid
  score       Int
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  hangout     Hangout  @relation(fields: [hangoutId], references: [id], onDelete: Cascade)
  rater       User     @relation("RatingsGiven", fields: [raterUserId], references: [id], onDelete: Cascade)
  rated       User     @relation("RatingsReceived", fields: [ratedUserId], references: [id], onDelete: Cascade)

  @@unique([hangoutId, raterUserId, ratedUserId])
  @@index([raterUserId, ratedUserId, score])
  @@map("hangout_ratings")
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}
model Block {
  id        String   @id @db.Uuid
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  blocker   User     @relation("Blocker", fields:[blockerId], references:[id], onDelete:Cascade)
  blocked   User     @relation("Blocked", fields:[blockedId], references:[id], onDelete:Cascade)
  @@unique([blockerId, blockedId])
  @@map("blocks")
}
model Report {
  id           String       @id @db.Uuid
  reporterId   String       @map("reporter_id") @db.Uuid
  targetUserId String       @map("target_user_id") @db.Uuid
  hangoutId    String?      @map("hangout_id") @db.Uuid
  reason       String
  details      String?
  status       ReportStatus @default(OPEN)
  assignedTo   String?      @map("assigned_to")
  resolution   String?
  updatedAt    DateTime     @updatedAt @map("updated_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  reporter     User         @relation("Reporter", fields:[reporterId], references:[id], onDelete:Cascade)
  targetUser   User         @relation("ReportedUser", fields:[targetUserId], references:[id], onDelete:Cascade)
  hangout      Hangout?     @relation(fields:[hangoutId], references:[id], onDelete:SetNull)
  actions      ModerationAction[]
  @@unique([reporterId, targetUserId, hangoutId])
  @@index([status, createdAt])
  @@map("reports")
}

enum ModerationActionType {
  NOTE
  WARNING
  SUSPEND
  BAN
  RESTORE
}

model ModerationAction {
  id           String               @id @db.Uuid
  reportId     String               @map("report_id") @db.Uuid
  targetUserId String               @map("target_user_id") @db.Uuid
  action       ModerationActionType
  reason       String
  adminId      String               @map("admin_id")
  createdAt    DateTime             @default(now()) @map("created_at")
  report       Report               @relation(fields: [reportId], references: [id], onDelete: Cascade)
  targetUser   User                 @relation("ModeratedUser", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([reportId, createdAt])
  @@index([targetUserId, createdAt])
  @@map("moderation_actions")
}

model ChatRoom {
  id        String    @id @db.Uuid
  hangoutId String    @unique @map("hangout_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  hangout   Hangout   @relation(fields: [hangoutId], references: [id], onDelete: Cascade)
  messages  Message[]
  @@map("chat_rooms")
}

model Message {
  id           String   @id @db.Uuid
  roomId       String   @map("room_id") @db.Uuid
  senderUserId String   @map("sender_user_id") @db.Uuid
  body         String
  createdAt    DateTime @default(now()) @map("created_at")
  room         ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender       User     @relation(fields: [senderUserId], references: [id], onDelete: Cascade)
  @@index([roomId, createdAt])
  @@map("messages")
}

model DirectChat {
  id            String          @id @db.Uuid
  userOneId     String          @map("user_one_id") @db.Uuid
  userTwoId     String          @map("user_two_id") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  userOne       User            @relation("DirectChatStarter", fields: [userOneId], references: [id], onDelete: Cascade)
  userTwo       User            @relation("DirectChatRecipient", fields: [userTwoId], references: [id], onDelete: Cascade)
  messages      DirectMessage[]

  @@unique([userOneId, userTwoId])
  @@index([userOneId, updatedAt])
  @@index([userTwoId, updatedAt])
  @@map("direct_chats")
}

model DirectMessage {
  id           String     @id @db.Uuid
  directChatId String     @map("direct_chat_id") @db.Uuid
  senderUserId String     @map("sender_user_id") @db.Uuid
  body         String
  createdAt    DateTime   @default(now()) @map("created_at")
  directChat   DirectChat @relation(fields: [directChatId], references: [id], onDelete: Cascade)
  sender       User       @relation(fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([directChatId, createdAt])
  @@map("direct_messages")
}

model JoinRequest {
  id        String            @id @db.Uuid
  hangoutId String            @map("hangout_id") @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  message   String?
  status    JoinRequestStatus @default(PENDING)
  attendanceStatus AttendanceStatus? @map("attendance_status")
  attendanceUpdatedAt DateTime? @map("attendance_updated_at")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  hangout   Hangout           @relation(fields: [hangoutId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([hangoutId, userId])
  @@index([hangoutId, status])
  @@map("join_requests")
}

model Interest {
  id    String @id @db.Uuid
  name  String @unique
  users UserInterest[]

  @@map("interests")
}

model UserInterest {
  userId     String @map("user_id") @db.Uuid
  interestId String @map("interest_id") @db.Uuid
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([userId, interestId])
  @@map("user_interests")
}

model RefreshToken {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model NewsletterSubscription {
  id                   String    @id @db.Uuid
  email                String    @unique
  unsubscribeTokenHash String    @unique @map("unsubscribe_token_hash")
  source               String?
  consentAt            DateTime  @map("consent_at")
  subscribedAt         DateTime  @default(now()) @map("subscribed_at")
  unsubscribedAt       DateTime? @map("unsubscribed_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@index([unsubscribedAt, subscribedAt])
  @@map("newsletter_subscriptions")
}
