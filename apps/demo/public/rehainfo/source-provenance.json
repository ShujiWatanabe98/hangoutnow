    "/rehainfo/prescriptions/patient/{recId}/list": "templates/prescription/list.html",
    "/rehainfo/schedule": "templates/schedule/index.html",
    "/rehainfo/therapists": "templates/schedule/therapists.html",
    "/rehainfo/attendance": "templates/schedule/attendance.html",
    "/rehainfo/ai-schedule": "templates/schedule/ai.html",
    "/rehainfo/billing-management": "templates/schedule/billing-management.html",
    "/rehainfo/schedule-management": "templates/schedule/operations.html"
  },
  "legacyIndependentRoutes": {
    "/smariha": "/rehainfo/",
    "/smariha-dashboard": "/rehainfo/",
    "/smariha-scheduler": "/rehainfo/schedule"
  },
  "sourceManifest": "apps/demo/rehainfo-source/source-manifest.json",
  "dataMode": "fictional-browser-demo; extracted prescription text is stored only in browser localStorage",
