{
  "source": "rehainfo-main/src/main/resources",
  "capturedAt": "2026-09-10",
  "sourcePolicy": "Public Smart Rehab screens must be generated from copied upstream Thymeleaf templates. Independently authored replacement UI is forbidden.",
  "generationCommand": "npm run sync:rehainfo -w @hangout-now/demo",
